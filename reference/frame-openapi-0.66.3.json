  "/automate/v1/asset/{frameRef}/{assetType}": {
   "post": {
    "tags": [
     "Assets in Frame"
    ],
    "summary": "Create Asset",
    "description": "Insert a 3D asset in the target frame environment.\n\n\nDue to current limitations, this is the suggested usage:\n  * use this method to create the asset\n  * Create an asset of the same type with the web interface\n  * Use the asset GET method to get the JSON data.\n  * Modify it as needed.\n  * Use the update/PATCH method to set the data on this asset.\n",
    "operationId": "createAssetInFrame",
    "parameters": [
     {
      "$ref": "#/components/parameters/frameRef"
     },
     {
      "in": "path",
      "name": "assetType",
      "required": true,
      "schema": {
       "type": "string",
       "enum": [
        "images",
        "models",
        "shapes",
        "audios",
        "pdfs",
        "spheres",
        "videos",
        "spawn-spots",
        "texts",
        "particles",
        "voice-zones",
        "streaming-screens",
        "polls",
        "news",
        "shaders",
        "text-areas",
        "NPCs",
        "agents",
        "whiteboards",
        "basemodel-chairs",
        "remotebrowsers"
       ]
      },
      "description": "The type of the asset you want to create.",
      "example": "images"
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Creation",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "message": {
           "type": "string"
          },
          "data": {
           "$ref": "#/components/schemas/frame"
          }
         }
        },
        "examples": {
         "default": {
          "summary": "Message with Data",
          "description": "Contains newly created asset data\n",
          "value": {
           "message": "some message",
           "data": "some asset?"
          }
         }
        }
       }
      },
      "links": {
       "ReadAsset": {
        "operationId": "readAsset",
        "parameters": {
         "assetId": "$response.body#/data/id"
        }
       },
       "UpdateAsset": {
        "operationId": "updateAsset",
        "parameters": {
         "assetId": "$response.body#/data/id"
        }
       },
       "DeleteAsset": {
        "operationId": "deleteAsset",
        "parameters": {
         "assetId": "$response.body#/data/id"
        }
       }
      }
     },
     "401": {
      "description": "Invalid Credentials"
     }
    },
    "security": [
     {
      "automateAuth": []
     }
    ]
   }
  },
